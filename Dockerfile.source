FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /srv/app
COPY requirements.txt requirements-source.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-source.txt
COPY app ./app
CMD ["celery", "-A", "app.core.celery_app.celery_app", "worker", "--loglevel=INFO", "--concurrency=1", "--queues=source"]

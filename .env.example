# Local demo defaults. Do not expose the dashboard publicly without authentication.
POSTGRES_DB=audit
POSTGRES_USER=audit
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+asyncpg://audit:change-this-local-password@db:5432/audit
REDIS_URL=redis://redis:6379/0
# Exact hostnames only. Defaults intentionally allow only the internal demo service.
AUTHORIZED_HOSTS=demo-target
DEMO_HOST=demo-target
LOG_RETENTION_DAYS=14
JOB_RETENTION_DAYS=30
MAX_REQUESTS_PER_JOB=3
REQUEST_TIMEOUT_SECONDS=5
REQUEST_INTERVAL_SECONDS=1.0
# Optional read-only discovery API credentials. Keep real values in local .env only.
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=
# Optional campaign agents use the OpenAI API. Keep the key only in local .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
